# Production settings for the VPS. Copy to /etc/assam_healthcare.env,
# fill in the values, then restrict it:
#   sudo chown root:assam /etc/assam_healthcare.env
#   sudo chmod 640 /etc/assam_healthcare.env
# Never commit the real file. Lines are KEY=value; put double quotes around
# values that contain spaces or < > characters.

DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-output-of-python-secrets-token_urlsafe-50
DJANGO_ALLOWED_HOSTS=assamhealthcare.pk,www.assamhealthcare.pk
DJANGO_CSRF_TRUSTED_ORIGINS=https://assamhealthcare.pk,https://www.assamhealthcare.pk

# nginx terminates HTTPS and passes X-Forwarded-Proto to Django.
DJANGO_BEHIND_PROXY=True

DJANGO_DB_PATH=/home/assam/assam_healthcare/db.sqlite3
DJANGO_STATIC_ROOT=/home/assam/assam_healthcare/staticfiles
DJANGO_MEDIA_ROOT=/home/assam/assam_healthcare/media

# Shared by all gunicorn workers for the rate limits on forms and sign-in.
DJANGO_CACHE_DIR=/home/assam/cache

# Admin address. Pick your own random word (letters, digits, dashes) and
# keep it private; the login page is then not at the /admin/ bots look for.
DJANGO_ADMIN_URL=manage-change-this-word

# Raise to 31536000 once HTTPS has worked for about a week.
DJANGO_SECURE_HSTS_SECONDS=0

DJANGO_LOG_LEVEL=INFO

# Email through Google Workspace (low volume: error reports, future quote
# alerts). Use a mailbox with 2-Step Verification on and an App Password.
DJANGO_EMAIL_HOST=smtp.gmail.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=True
DJANGO_EMAIL_USER=website@assamhealthcare.pk
DJANGO_EMAIL_PASSWORD=replace-with-google-app-password
DJANGO_DEFAULT_FROM_EMAIL="Assam Healthcare <website@assamhealthcare.pk>"
DJANGO_ADMINS=it@assamhealthcare.pk
