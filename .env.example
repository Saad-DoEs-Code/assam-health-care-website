# Example environment for production. Copy the names into your hosting
# provider's environment settings; never commit real values.
# Django reads these from the process environment (it does not load this file).

DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=www.example.com,example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://www.example.com,https://example.com

# Optional
DJANGO_DB_PATH=/srv/assam_healthcare/db.sqlite3
DJANGO_STATIC_ROOT=/srv/assam_healthcare/staticfiles
DJANGO_MEDIA_ROOT=/srv/assam_healthcare/media
DJANGO_BEHIND_PROXY=True
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_COOKIES=True
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_LOG_LEVEL=INFO

# Email (not used by the website yet; needed for Django error emails)
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USER=
DJANGO_EMAIL_PASSWORD=
DJANGO_EMAIL_USE_TLS=True
DJANGO_DEFAULT_FROM_EMAIL=
